/cache/
*.utf8.md
*.knit.md
.quarto/

# --- Kompilerad kod (om src/ läggs till) ---
src/*.o
src/*.so
src/*.dll

# --- Övrigt ---
po/*~
rsconnect/

# --- Operativsystem och Office ---
Thumbs.db
desktop.ini
.DS_Store
~$*
